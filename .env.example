# Copy to .env and fill in. Never commit .env.
# Kalshi API key (create in the DEMO environment for authenticated calls).
KALSHI_API_KEY_ID=
# Path to the RSA private key PEM downloaded when creating the API key.
KALSHI_PRIVATE_KEY_PATH=
# Discord webhook for alerts/digests/heartbeats. Leave empty to disable.
DISCORD_WEBHOOK_URL=
